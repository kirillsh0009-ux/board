generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Board {
  id        String    @id
  name      String    @default("Новая доска")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  elements  Element[]
}

model Element {
  id        String   @id
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}
