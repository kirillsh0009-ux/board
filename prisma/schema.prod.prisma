// Production schema (PostgreSQL — Neon/Supabase free tier).
// Used ONLY on the hosting (see render.yaml buildCommand).
// The sandbox keeps using prisma/schema.prisma (SQLite) — keep models in sync!

generator client {
  provider      = "prisma-client-js"
  // rhel-openssl-3.0.x — Vercel serverless runtime (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Board {
  id        String    @id
  name      String    @default("Новая доска")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  elements  Element[]
}

model Element {
  id        String   @id
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  type      String
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId])
}
